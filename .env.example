# Public site URL used for canonical links, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://ssunicomservice.com

# Contact form delivery (server-side only; never prefix with NEXT_PUBLIC_).
# Option 1: Resend
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Must be on a domain verified in Resend, e.g. "SS Unicom Website <website@ssunicomservice.com>"
CONTACT_FROM_EMAIL=
# Option 2: any HTTPS endpoint that accepts JSON (Formspree, Zapier, Make, Apps Script...)
CONTACT_WEBHOOK_URL=

# Analytics (optional). Leave empty to load no analytics at all.
NEXT_PUBLIC_GA_ID=
