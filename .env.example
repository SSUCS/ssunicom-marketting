# ─── Required in production ──────────────────────────────────────────────
# Long random string used to sign CMS logins. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=

# Public URL of the site (canonical links, sitemap, Open Graph, schema).
NEXT_PUBLIC_SERVER_URL=https://ssunicomservice.com

# ─── Database ────────────────────────────────────────────────────────────
# Local development: leave empty to use a SQLite file at ./.data/payload.db
# Production: a libSQL / Turso database (Vercel Marketplace → Turso)
DATABASE_URI=
DATABASE_AUTH_TOKEN=

# ─── Media storage ───────────────────────────────────────────────────────
# Production: Vercel Blob read/write token. Leave empty locally (files go to ./media)
BLOB_READ_WRITE_TOKEN=

# ─── Email (form notifications, password resets) ─────────────────────────
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=website@ssunicomservice.com
EMAIL_FROM_NAME=SS Unicom Website

# ─── Draft preview & scheduled jobs ──────────────────────────────────────
PREVIEW_SECRET=
CRON_SECRET=

# ─── First admin user (created by the seed if no user exists) ────────────
SEED_ADMIN_EMAIL=admin@ssunicomservice.com
SEED_ADMIN_PASSWORD=
