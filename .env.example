# ─── Required in production ──────────────────────────────────────────────
# Checked by src/env.ts (t3-env). With NODE_ENV=production (next build / next start) these must
# all be set or the build stops: PAYLOAD_SECRET, NEXT_PUBLIC_SERVER_URL, DATABASE_URI,
# DATABASE_AUTH_TOKEN, UPLOADTHING_TOKEN, RESEND_API_KEY,
# EMAIL_FROM_ADDRESS, EMAIL_FROM_NAME. Locally everything is optional.
# SKIP_ENV_VALIDATION=1 bypasses the check.
#
# Long random string used to sign CMS logins. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=

# Public URL of the site (canonical links, sitemap, Open Graph, schema).
NEXT_PUBLIC_SERVER_URL=https://www.ssuniversalcommunicationservices.com

# ─── Database ────────────────────────────────────────────────────────────
# Local development: leave empty to use a SQLite file at ./.data/payload.db
# Production: a Turso database. Both values are in the Turso dashboard:
#   DATABASE_URI        → your database's URL (libsql://<db>-<org>.turso.io)
#   DATABASE_AUTH_TOKEN → Create Token on the same database page
DATABASE_URI=
DATABASE_AUTH_TOKEN=

# ─── Media storage ───────────────────────────────────────────────────────
# UploadThing token: uploadthing.com dashboard → your app → API Keys → UPLOADTHING_TOKEN.
# Leave empty to keep uploads on local disk (./media).
UPLOADTHING_TOKEN=

# ─── Email (form notifications, password resets) ─────────────────────────
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=website@ssunicomservice.com
EMAIL_FROM_NAME=SS Unicom Website
