{
  "name": "ssunicom",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run db:prepare && next build",
    "start": "next start",
    "db:prepare": "cross-env PAYLOAD_BUILD=1 NODE_OPTIONS=--no-deprecation payload migrate && cross-env PAYLOAD_BUILD=1 NODE_OPTIONS=--no-deprecation payload run src/seed/run.ts",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation payload run src/seed/run.ts",
    "seed:fresh": "cross-env SEED_FRESH=1 NODE_OPTIONS=--no-deprecation payload run src/seed/run.ts",
    "migrate": "cross-env NODE_OPTIONS=--no-deprecation payload migrate",
    "migrate:create": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:create",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@payloadcms/db-sqlite": "3.92.1",
    "@payloadcms/email-resend": "3.92.1",
    "@payloadcms/live-preview-react": "3.92.1",
    "@payloadcms/next": "3.92.1",
    "@payloadcms/plugin-form-builder": "3.92.1",
    "@payloadcms/plugin-redirects": "3.92.1",
    "@payloadcms/plugin-seo": "3.92.1",
    "@payloadcms/richtext-lexical": "3.92.1",
    "@payloadcms/storage-vercel-blob": "3.92.1",
    "@payloadcms/ui": "3.92.1",
    "cross-env": "^10.1.0",
    "graphql": "^16.14.2",
    "lucide-react": "^1.63.0",
    "next": "16.4.3",
    "payload": "3.92.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "sass": "^1.106.1",
    "tailwindcss": "^4.3.3",
    "three": "^0.186.1",
    "typescript": "^5.9.3"
  }
}
